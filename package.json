{
  "name": "hplayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter hplayer_web dev",
    "build": "pnpm --filter hplayer_web build",
    "preview": "pnpm --filter hplayer_web preview",
    "type-check": "pnpm -r --parallel type-check",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:android": "pnpm build && pnpm --filter hplayer_android sync",
    "sync:android": "pnpm --filter hplayer_android sync",
    "open:android": "pnpm --filter hplayer_android open",
    "run:android": "pnpm build && pnpm --filter hplayer_android run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "1.57.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.0",
    "pinia": "^2.2.0",
    "playwright": "1.57.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0"
  }
}
